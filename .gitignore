# Environment and secrets — NEVER commit these
.env
.env.*
*.pem
*.key
local.settings.json
appsettings.Development.json
secrets.json

# Python
__pycache__/
*.py[cod]
*.so
.Python
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Node / frontend
node_modules/
dist/
build/
.vite/
npm-debug.log*
yarn-error.log*

# Azure
.azure/
bin/
obj/
.python_packages/

# Machine learning artefacts — models are registered in Azure ML, not committed
*.h5
*.keras
*.pkl
*.joblib
*.onnx
mlruns/
outputs/

# Data — never commit raw or processed data to the repository
data/raw/
data/processed/
data/interim/
*.csv
*.parquet
*.tif
*.nc
!docs/**/*.csv

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# ---------------------------------------------------------------------------
# Phase-II additions
# ---------------------------------------------------------------------------

# Teammate handoff packages. These files are written here for local end-to-end
# testing but are committed by their owners from their own GitHub accounts, on
# their own branches, so that the contribution record stays accurate.
# See CLAUDE.md, "Teammate handoff rule".
handoff/

# Azure Functions local configuration. Holds connection strings.
local.settings.json

# Synthesised speech cached during local runs.
*.mp3
*.wav

# Virtual environment
.venv/
venv/

# mypy
.mypy_cache/

# Simulation outputs and test fixtures are versioned: they are the evidence for
# Objective 6 and for the feeder-schedule parser test. These negations override
# the blanket *.csv rule above. Raw downloads under data/raw/ stay ignored.
!results/**/*.csv
!results/**/*.png
!tests/fixtures/**/*.csv
